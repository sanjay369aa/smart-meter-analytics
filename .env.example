# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AWS S3 Cloud Storage Configuration (Backend Only - NEVER expose in frontend)
# Leave unset to automatically operate in transparent Local Simulation Mode.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_PREFIX="smart-meter-datasets/"
